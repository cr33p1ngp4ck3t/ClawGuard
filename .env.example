# ClawGuard research gateway
# Generate distinct values with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave neither credential blank when starting the gateway.
CLAWGUARD_ADMIN_KEY=
CLAWGUARD_AGENT_KEYS='{}'
# Example shape: {"research-agent":"<a separately generated key>"}
# Used by the SDK only; never added to NEXT_PUBLIC variables.
CLAWGUARD_API_KEY=
GROQ_API_KEY=
DB_PATH=clawguard.db
PROXY_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LLM_TIMEOUT=3
LLM_MODEL=llama-3.3-70b-versatile
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws
